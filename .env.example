# CraftZone Auto-Publisher Environment Variables
# Create a .env file locally with your actual credentials for testing.
# For production, add these as Repository Secrets in GitHub Actions (Settings > Secrets and variables > Actions)

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# WordPress Credentials
# Create an application password in WordPress: Users > Profile > Application Passwords
WP_USERNAME=your_wordpress_username
WP_APP_PASSWORD=your_wordpress_application_password
WP_URL=https://your-wordpress-site.com
