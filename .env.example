# CraftZone Auto-Publisher + David Quaid SEO Automation
# Create a .env file locally with your actual credentials for testing.
# For production, add these as Repository Secrets in GitHub Actions (Settings > Secrets and variables > Actions)

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# WordPress Credentials
# Create an application password in WordPress: Users > Profile > Application Passwords
WP_USERNAME=your_wordpress_username
WP_APP_PASSWORD=your_wordpress_application_password
WP_URL=https://your-wordpress-site.com

# NewsData.io API Key (for trending topic sourcing)
NEWSDATA_API_KEY=your_newsdata_api_key_here

# Google Search Console Service Account (JSON string)
# Required for: Fresh Start Hack, PageRank analysis, Indexing API pings
# Generate at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Grant "Search Console API" and "Web Search Indexing API" access
GSC_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Telegram Syndication
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@your_telegram_channel_id
TELEGRAM_CHAT_ID=your_telegram_chat_id_for_audit_alerts

# Twitter/X Syndication
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here
